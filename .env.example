# Public Supabase project credentials — safe to bundle into the client app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key, used exclusively by supabase/seed/import-exercises.ts.
# Never prefix this with EXPO_PUBLIC_ — it must not end up in the app bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
